{
  "manifest_version": 3,
  "name": "Site Account Switcher",
  "short_name": "AcctSwitch",
  "version": "1.0.0",
  "description": "Keep several Claude / ChatGPT (or any site) logins and switch between them by swapping that site's cookies only.",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage", "unlimitedStorage", "scripting", "browsingData", "activeTab"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://auth.openai.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Switch account for this site",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
